      "css": ".ds-nav{font-family:var(--font-manrope,Manrope),sans-serif;display:flex;align-items:center;gap:29px;padding:20px;background:white;font-size:12px;font-weight:650;color:var(--ink,#222b27)}.ds-nav a{color:inherit;text-decoration:none}.ds-nav a:hover{color:var(--red,#921f27)}.ds-nav a:focus-visible{outline:3px solid var(--focus,#bc7321);outline-offset:5px}.ds-nav .ds-nav-login{font-family:var(--font-manrope,Manrope),sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:13px 25px;border:1px solid transparent;border-radius:3px;font-size:13px;font-weight:700;line-height:1.4;transition:background-color 160ms ease,color 160ms ease,transform 160ms cubic-bezier(.23,1,.32,1);min-height:42px;padding:11px 19px;background:var(--green,#24713f);color:white}.ds-nav .ds-nav-login:hover{background:var(--green-deep,#19572f)}@media(max-width:760px){.ds-nav{align-items:stretch;flex-direction:column;gap:24px}}"
