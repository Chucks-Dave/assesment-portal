      "kind": "button",
      "refersTo": "button-primary",
      "description": "Portal and form actions.",
      "html": "<button class=\"ds-primary\">Enter student portal</button>",
      "css": ".ds-primary{font-family:var(--font-manrope,Manrope),sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:13px 25px;border:1px solid transparent;border-radius:3px;font-size:13px;font-weight:700;line-height:1.4;transition:background-color 160ms ease,color 160ms ease,transform 160ms cubic-bezier(.23,1,.32,1);background:var(--green,#24713f);color:white}.ds-primary:hover{background:var(--green-deep,#19572f)}.ds-primary:active{transform:scale(.97)}.ds-primary:focus-visible{outline:3px solid var(--focus,#bc7321);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:active{transform:none}}"
    },
