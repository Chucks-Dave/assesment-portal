  "narrative": {
    "northStar": "The academic welcome",
    "overview": "UEMP adapts the approved school reference into a university portal identity: university red frames the page, forest green marks actions, and white sections give photography and clear headings room to breathe. Manrope supplies a single readable voice across public pages and authentication.\n\nThe material is flat and restrained. Illustrative campus and student photographs carry the atmosphere; compact rectangular controls and carefully spaced text carry the tasks. The implementation is the visual source of truth; the supplied screenshot establishes the red/green direction rather than an independently approved generated composition.",
    "keyCharacteristics": [
      "University red framing and forest-green actions.",
      "Photographic media with readable dark overlays.",
      "Compact rectangular controls and generous section spacing.",
      "Responsive stacking, visible focus, and reduced motion."
    ],
    "rules": [
      {
        "name": "The Action Color Rule",
        "body": "Use forest green for primary actions and university red for section headings and page framing.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use color, borders, and image overlap to separate content; reserve the existing diffuse shadow for the mobile navigation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain the red/green identity and use the primary green treatment for portal actions.",
      "Do keep the Manrope hierarchy, visible keyboard focus, and mobile input text at 16px.",
      "Do use illustrative photography without presenting it as a supplied institutional asset.",
      "Do preserve user-controlled slides and the reduced-motion override."
    ],
    "donts": [
      "Don't replace compact rectangular controls with pill-shaped buttons.",
      "Don't add ambient card shadows; use the existing flat surfaces and borders.",
      "Don't imply that illustrative photographs establish a particular institution."
    ]
  }
}
