      "kind": "input",
      "refersTo": "input",
      "description": "Visible label and accessible invalid state.",
      "html": "<div class=\"ds-field\"><label for=\"ds-email\">University email address</label><input id=\"ds-email\" type=\"email\" placeholder=\"you@university.edu\"></div>",
      "css": ".ds-field{font-family:var(--font-manrope,Manrope),sans-serif;color:var(--ink,#222b27)}.ds-field label{display:block;margin-bottom:7px;font-size:12px;font-weight:750}.ds-field input{box-sizing:border-box;width:100%;min-height:50px;padding:13px 14px;border:1px solid var(--input-border,#b8c3ba);border-radius:4px;background:white;color:var(--ink,#222b27);font:inherit;font-size:14px;caret-color:var(--green,#24713f)}.ds-field input[aria-invalid=true]{border-color:var(--red,#921f27)}.ds-field input:focus-visible{outline:3px solid var(--focus,#bc7321);outline-offset:5px}@media(max-width:760px){.ds-field input{font-size:16px}}"
    },
